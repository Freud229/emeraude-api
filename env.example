APP_NAME="Emeraude Optique API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Base de données ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emeraude_optique
DB_USERNAME=root
DB_PASSWORD=

# ─── Cache & Sessions ──────────────────────────────
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# ─── Stockage fichiers ─────────────────────────────
FILESYSTEM_DISK=public

# ─── Mail (optionnel pour les notifications) ───────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=emeraudeoptiqueas@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=emeraudeoptiqueas@gmail.com
MAIL_FROM_NAME="Emeraude Optique"

# ─── CORS — autorise le frontend React ────────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000,127.0.0.1:5173
